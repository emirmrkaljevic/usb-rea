{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.emirmrkaljevic/usb-rea",
  "description": "Reverse engineer USB gadgets: capture traffic, infer the protocol, generate a pyusb driver.",
  "repository": {
    "url": "https://github.com/emirmrkaljevic/usb-rea",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "usb-rea",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
